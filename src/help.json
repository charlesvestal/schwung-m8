{
  "title": "M8 LPP Emulator",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Launchpad Pro",
        "emulator for the",
        "Dirtywave M8.",
        "",
        "Maps Move's pads,",
        "buttons, and knobs",
        "to Launchpad Pro",
        "protocol for M8",
        "control.",
        "",
        "Requires M8 device",
        "connected via USB."
      ]
    },
    {
      "title": "Controls",
      "children": [
        {
          "title": "Pads",
          "lines": [
            "8x4 pad grid maps",
            "to Launchpad Pro",
            "10x10 grid.",
            "",
            "Wheel Touch: toggle",
            " top/bottom view",
            "",
            "Colors from M8 are",
            "translated to Move",
            "LED colors in real",
            "time."
          ]
        },
        {
          "title": "Knobs & Banks",
          "lines": [
            "Nine knob banks, 0-8.",
            "",
            "Even steps (2, 4, 6,",
            " 8, 10, 12, 14, 16)",
            " select banks 0-7.",
            " The odd steps are",
            " Launchpad top-row",
            " buttons, not banks.",
            "",
            "Press the step of a",
            "bank you are already",
            "on to return to bank",
            "8, the default:",
            "Track 1-8 plus Main",
            "volume, CC 85-93.",
            "",
            "Shift+that step picks",
            " a save slot, 0-7.",
            " The current config",
            " is written to",
            " m8knobconfig.json",
            " first.",
            "",
            "Knob values sent",
            "to M8 as encoder",
            "input."
          ]
        },
        {
          "title": "Buttons",
          "lines": [
            "Menu: Launchpad",
            " setup/session btn",
            "",
            "Back: Launchpad",
            " back/stop button",
            "",
            "Capture: additional",
            " Launchpad control",
            "",
            "Track buttons map",
            "to LP function row."
          ]
        }
      ]
    }
  ]
}
